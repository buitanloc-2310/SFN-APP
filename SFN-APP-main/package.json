{
  "name": "sky-first-digital-information-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cổng Thông tin Số Sky First — Digital Information Infrastructure on Cloudflare Workers, D1 and R2",
  "scripts": {
