{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sfn-app",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sfn-app-db",
      "database_id": "a59afb69-f8fd-4c29-8afa-601d2cdfd1ed"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sfn-app-files"
    }
  ],

  "vars": {
    "APP_URL": "https://ctt.skyfirst.io.vn",
    "MAIL_FROM": "Sky First Network <noreply@skyfirst.io.vn>",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_REDIRECT_URI": "https://ctt.skyfirst.io.vn/api/auth/google/callback",
    "TURNSTILE_SITE_KEY": ""
  },

  "triggers": {
    "crons": [
      "20 2 * * *"
    ]
  }
}
